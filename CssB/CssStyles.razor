@using CssB.Core
@implements IDisposable

<p>123test123</p>
<style>
    @_css
</style>

@code {
    private MarkupString _css = (MarkupString)"";

    protected override void OnInitialized()
    {
        ClassRegistry.DefaultRegistry.OnClassAdded += OnClassAdded;
        UpdateCss();
    }

    private void OnClassAdded(object? sender, UtilityClass c)
    {
        InvokeAsync(() =>
        {
            UpdateCss();
            StateHasChanged();
        });
    }

    private void UpdateCss()
    {
        _css = (MarkupString)ClassRegistry.DefaultRegistry.Css;
    }

    public void Dispose()
    {
        ClassRegistry.DefaultRegistry.OnClassAdded -= OnClassAdded;
    }
}