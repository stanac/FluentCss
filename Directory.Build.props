<Project>
    <PropertyGroup>
	    <Version>0.3.0</Version>
		<PackageLicenseExpression>0BSD</PackageLicenseExpression>
		<Authors>stanac</Authors>
		<Summary>Fluent strongly typed CSS for Blazor, MVC and Razor Pages</Summary>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageTags>css</PackageTags>
		<PackageProjectUrl>https://fluentcss.stanac.dev</PackageProjectUrl>
		<RepositoryUrl>https://github.com/stanac/FluentCss</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>
</Project>