@using FluentCss.Core
@implements IDisposable

<style>
    @_css
</style>

@code {
    private MarkupString _css = (MarkupString)"";
    private bool _updatePending;

    protected override void OnInitialized()
    {
        ClassRegistry.DefaultRegistry.OnClassAdded += OnClassAdded;
        UpdateCss();
    }

    private void OnClassAdded(object? sender, UtilityClass c)
    {
        if (_updatePending)
        {
            return;
        }

        _updatePending = true;

        InvokeAsync(() =>
        {
            UpdateCss();
            StateHasChanged();
            _updatePending = false;
        });
    }

    private void UpdateCss()
    {
        _css = (MarkupString)ClassRegistry.DefaultRegistry.Css;
    }

    public void Dispose()
    {
        ClassRegistry.DefaultRegistry.OnClassAdded -= OnClassAdded;
    }
}