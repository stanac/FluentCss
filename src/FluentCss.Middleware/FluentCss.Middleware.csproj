<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>ASP.NET Core middleware and DI extensions for FluentCss, plus the MVC/Razor Pages tag helpers: serve the generated stylesheet and keep it in sync.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="fluentcss.js" />
    <EmbeddedResource Include="fluentcss.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentCss.Core\FluentCss.Core.csproj" />
  </ItemGroup>

</Project>
