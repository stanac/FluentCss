<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>14</LangVersion>
		<Description>Fluent strongly typed CSS for Blazor, MVC and Razor Pages</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="True" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FluentCss" />
		<InternalsVisibleTo Include="FluentCss.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="ZBase32" Version="1.1.0" />
	</ItemGroup>

</Project>
