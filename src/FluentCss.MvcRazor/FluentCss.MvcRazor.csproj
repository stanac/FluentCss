<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>ASP.NET Core MVC and Razor Pages integration for FluentCss: a tag helper and middleware that serve the generated stylesheet.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="fluentcss.js" />
    <EmbeddedResource Include="fluentcss.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentCss.Core\FluentCss.Core.csproj" />
  </ItemGroup>

</Project>
