<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FluentCss MVC</title>
    <script>
        // Persist the theme in a cookie so the server can render the theme class
        // on <html> and avoid a flash of the light theme. localStorage stays as a
        // fallback for visitors whose stored choice predates the cookie.
        (function () {
            var theme = null;
            try {
                var match = /(?:^|;\s*)fluentcss-theme=([^;]+)/.exec(document.cookie);
                theme = (match && decodeURIComponent(match[1])) || localStorage.getItem('fluentcss-theme');
            } catch (e) { }

            if (theme !== 'dark' && theme !== 'light') {
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                theme = prefersDark ? 'dark' : 'light';
            }

            document.documentElement.classList.toggle('theme-dark', theme === 'dark');

            try {
                document.cookie = 'fluentcss-theme=' + theme + ';path=/;max-age=31536000;samesite=lax';
                localStorage.setItem('fluentcss-theme', theme);
            } catch (e) { }
        })();

        function fcToggleTheme() {
            var theme = document.documentElement.classList.toggle('theme-dark') ? 'dark' : 'light';
            try {
                document.cookie = 'fluentcss-theme=' + theme + ';path=/;max-age=31536000;samesite=lax';
                localStorage.setItem('fluentcss-theme', theme);
            } catch (e) { }
        }
    </script>
    <link rel="stylesheet" href="/_content/FluentCss.Middleware/preflight.css" />
    <fluent-css />
</head>
<body class="@Styles.Shell">
    <header class="@Styles.Header">
        <nav class="@Styles.Nav">
            <a href="/" class="@Styles.Brand">FluentCss MVC</a>
            <div class="@Styles.NavLinks">
                <a href="/" class="@GetLinkClass("/")">Home</a>
                <a href="/Home/About" class="@GetLinkClass("/Home/About")">About</a>
                <a href="/Home/Contact" class="@GetLinkClass("/Home/Contact")">Contact</a>
                <button type="button" class="@Styles.ThemeButton" onclick="fcToggleTheme()">Theme</button>
            </div>
        </nav>
    </header>

    <main class="@Styles.Main">
        @RenderBody()
    </main>

    <footer class="@Styles.Footer">
        &copy; @DateTime.Now.Year FluentCss MVC test site
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private string GetLinkClass(string path)
    {
        var current = ViewContext.HttpContext.Request.Path.Value ?? "/";
        var isActive = path == "/"
            ? current == "/"
            : current.StartsWith(path, StringComparison.OrdinalIgnoreCase);

        return isActive ? Styles.NavLinkActive : Styles.NavLink;
    }
}
