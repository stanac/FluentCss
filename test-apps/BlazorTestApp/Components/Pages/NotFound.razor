@page "/not-found"
@layout MainLayout

<div class="@Css.TextCenter().Py(12)">
    <h3 class="@Css.Text2Xl().FontBold().Color(Color.Slate900).Mb(4)">Not Found</h3>
    <p class="@Css.Color(Color.Slate500).Mb(6)">Sorry, the content you are looking for does not exist.</p>
    <a href="" class="@Css.InlineBlock().Px(6).Py(3).RoundedMd().Background(Color.Blue500)
                        .Color(Color.White).FontBold().NoUnderline()
                        .Hover(h => h.Background(Color.Blue600))
                        .Focus(f => f.Ring(3, Color.Blue300).OutlineHidden())">
        Go Home
    </a>
</div>