@page "/"

<PageTitle>Home</PageTitle>

<h1 class="@Css.Text3Xl().FontBold().Color(Color.Slate900).Mb(6)">
    Hello, FluentCss!
</h1>

<p class="@Css.TextLg().Color(Color.Slate600).Mb(8).MaxW(Size._2Xl)">
    Utility-first CSS builder for .NET — all the styling on this page is generated by FluentCss,
    with <strong class="@Css.FontBold().Color(Color.Slate800)">zero hand-written CSS</strong>.
</p>

<section class="@Css.Mb(8)">
    <h2 class="@Css.TextXl().FontBold().Color(Color.Slate800).Mb(4)">Color Palette</h2>
    <div class="@Css.Grid().GridCols(3) @Css.MinMd(md => md.GridCols(6)).Gap(4)">
        <div class="@Css.P(4).RoundedMd().Background(Color.Red400).Color(Color.White).FontBold()">Red 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Orange400).Color(Color.White).FontBold()">Orange 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Amber400).Color(Color.White).FontBold()">Amber 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Yellow400).Color(Color.White).FontBold()">Yellow 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Green400).Color(Color.White).FontBold()">Green 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Emerald400).Color(Color.White).FontBold()">Emerald 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Teal400).Color(Color.White).FontBold()">Teal 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Cyan400).Color(Color.White).FontBold()">Cyan 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Blue400).Color(Color.White).FontBold()">Blue 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Indigo400).Color(Color.White).FontBold()">Indigo 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Violet400).Color(Color.White).FontBold()">Violet 400</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Purple400).Color(Color.White).FontBold()">Purple 400</div>
    </div>
</section>

<section class="@Css.Mb(8)">
    <h2 class="@Css.TextXl().FontBold().Color(Color.Slate800).Mb(4)">Hover &amp; Focus</h2>
    <div class="@Css.Flex(FlexDirection.Col, gap: 4) @Css.MinMd(md => md.Flex(FlexDirection.Row))">
        <button class="
            @Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
            @Css.Background(Color.Blue500).Color(Color.White)
            @Css.Hover(h => h.Background(Color.Blue600))
            @Css.Focus(f => f.Ring(3, Color.Blue300).OutlineHidden())">
            Hover Me
        </button>
        <button class="
            @Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
            @Css.Background(Color.Green500).Color(Color.White)
            @Css.Hover(h => h.Background(Color.Green600))
            @Css.Focus(f => f.Ring(3, Color.Green300).OutlineHidden())">
            Click Me
        </button>
    </div>
</section>

<section class="@Css.Mb(8)">
    <h2 class="@Css.TextXl().FontBold().Color(Color.Slate800).Mb(4)">Responsive Cards</h2>
    <div class="@Css.Grid().GridCols(1) @Css.MinMd(md => md.GridCols(3)).Gap(6)">
        <div class="@Css.P(6).RoundedLg().Border().BorderColor(Color.Slate200).ShadowMd()
                        .Hover(h => h.ShadowLg())">
            <h3 class="@Css.FontBold().Color(Color.Slate900).Mb(2)">Flex</h3>
            <p class="@Css.TextSm().Color(Color.Slate500)">The FluentCss lib provides Flex, Grid, Spacing, Typography, and more — all type-safe.</p>
        </div>
        <div class="@Css.P(6).RoundedLg().Border().BorderColor(Color.Slate200).ShadowMd()
                        .Hover(h => h.ShadowLg())">
            <h3 class="@Css.FontBold().Color(Color.Slate900).Mb(2)">Fast</h3>
            <p class="@Css.TextSm().Color(Color.Slate500)">Classes are deduplicated automatically. You compose styles, FluentCss handles the CSS output.</p>
        </div>
        <div class="@Css.P(6).RoundedLg().Border().BorderColor(Color.Slate200).ShadowMd()
                        .Hover(h => h.ShadowLg())">
            <h3 class="@Css.FontBold().Color(Color.Slate900).Mb(2)">Fluent</h3>
            <p class="@Css.TextSm().Color(Color.Slate500)">Chain methods like <code class="@Css.Background(Color.Slate100).Px(1).Py(0).RoundedSm().TextXs()">.Background().Color().P()</code> for clean, readable style composition.</p>
        </div>
    </div>
</section>

<section class="@Css.Mb(8)">
    <h2 class="@Css.TextXl().FontBold().Color(Color.Slate800).Mb(4)">Dark Mode</h2>
    <p class="@Css.Color(Color.Slate600).Mb(4)">Toggle the theme to see dark mode styles:</p>

    <button onclick="document.documentElement.classList.toggle('theme-dark')"
            class="@Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
                      .Background(Color.Slate800).Color(Color.White)
                      .Hover(h => h.Background(Color.Slate700))
                      .Focus(f => f.Ring(3, Color.Slate300).OutlineHidden())">
        Toggle Dark Mode
    </button>

    <div class="@Css.Mt(6).P(6).RoundedLg().Border().BorderColor(Color.Slate200)
                    @Dark.Background(Color.Slate800).BorderColor(Color.Slate700)
                    @Css.Flex(FlexDirection.Col, gap: 4)">
        <p class="@Css.Color(Color.Slate900).FontBold()
                   @Dark.Color(Color.White)">
            This card switches to dark mode ✨
        </p>
        <p class="@Css.Color(Color.Slate500).TextSm()
                   @Dark.Color(Color.Slate300)">
            Use <code class="@Css.Background(Color.Slate100).Px(1).RoundedSm().TextXs()
                              @Dark.Background(Color.Slate700)">FluentCssBuilder.Dark</code> to define dark theme styles.
        </p>
    </div>
</section>