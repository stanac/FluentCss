@page "/not-found"
@layout MainLayout

<PageTitle>Not found - FluentCss SSR</PageTitle>

<div class="@Css.TextCenter().Py(12)">
    <p class="@Css.Text3Xl().FontBold().Color(Color.Blue600) @Dark.Color(Color.Blue400)">404</p>
    <h1 class="@Css.Text2Xl().FontBold().Color(Color.Slate900).Mb(2) @Dark.Color(Color.White)">Page not found</h1>
    <p class="@Css.Color(Color.Slate600).Mb(6) @Dark.Color(Color.Slate300)">The page you are looking for does not exist.</p>
    <a href="/" data-enhance-nav="true" class="@Css.InlineBlock().Px(6).Py(3).RoundedLg().Background(Color.Blue600).Color(Color.White).FontBold().NoUnderline().Hover(h => h.Background(Color.Blue700))">
        Back home
    </a>
</div>
