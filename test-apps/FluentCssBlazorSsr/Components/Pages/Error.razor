@page "/Error"

<PageTitle>Error - FluentCss SSR</PageTitle>

<div class="@Css.TextCenter().Py(12)">
    <h1 class="@Css.Text2Xl().FontBold().Color(Color.Slate900).Mb(2) @Dark.Color(Color.White)">Something went wrong</h1>
    <p class="@Css.Color(Color.Slate600) @Dark.Color(Color.Slate300)">
        An unexpected error occurred while processing your request.
    </p>
</div>
