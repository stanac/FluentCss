<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/FluentCss.Blazor/preflight.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <FluentCss.Blazor.CssStyles/>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('fluentcss-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('theme-dark');
                }
            } catch (e) { }
        })();

        function fcToggleTheme() {
            var root = document.documentElement;
            root.classList.toggle('theme-dark');
            try {
                localStorage.setItem('fluentcss-theme', root.classList.contains('theme-dark') ? 'dark' : 'light');
            } catch (e) { }
        }
    </script>
</head>

<body class="@BodyClass">
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly string BodyClass =
        $"{Css.Background(Color.White).Color(Color.Slate900)} " +
        $"{Dark.Background(Color.Slate950).Color(Color.Slate100)}";
}
