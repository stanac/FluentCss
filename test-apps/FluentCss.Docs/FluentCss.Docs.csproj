<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="[10.*, 11)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentCss\FluentCss.csproj" />
  </ItemGroup>

  <!--
    Regenerate the client-side search index on Release builds only. Debug builds
    use the committed wwwroot/search-index.json so day-to-day builds stay fast.
    The indexer is a separate tool that renders the docs with HtmlRenderer; the
    nested invocation clears the guard property so it cannot recurse.
  -->
  <Target Name="GenerateDocsSearchIndex"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(SkipDocsSearchIndexGeneration)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\FluentCss.Docs.Indexer\FluentCss.Docs.Indexer.csproj&quot; --configuration Release --no-launch-profile -- &quot;$(MSBuildThisFileDirectory)wwwroot\search-index.json&quot;"
          EnvironmentVariables="SkipDocsSearchIndexGeneration=true" />
  </Target>

</Project>
