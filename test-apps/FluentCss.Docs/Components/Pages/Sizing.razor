@page "/docs/sizing"

<PageTitle>Sizing - FluentCss</PageTitle>

<DocHeader Title="Sizing"
           Description="Set width and height with the spacing scale, arbitrary Length values or the predefined Size keywords." />

<h2 class="@DocsStyles.H2">Width and height</h2>

<p class="@DocsStyles.P">
    The numeric width and height helpers use the same scale as spacing. There are also a few named
    keywords for common cases.
</p>

<ApiTable Rows="@SizeUtilities" />

<Example Code="@SizeExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 3)">
        <div class="@Css.W(32).H(8).RoundedMd().Background(Color.Blue500)"></div>
        <div class="@Css.WFull().H(8).RoundedMd().Background(Color.Indigo500)"></div>
        <div class="@Css.W(16).HFull().RoundedMd().Background(Color.Violet500)"></div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Minimum and maximum</h2>

<p class="@DocsStyles.P">
    Min and max helpers take either a predefined <code class="@DocsStyles.InlineCode">Size</code>
    value or any <code class="@DocsStyles.InlineCode">Length</code>. Use
    <code class="@DocsStyles.InlineCode">Size</code> for the named keywords and
    <code class="@DocsStyles.InlineCode">Length</code> for arbitrary values, other units and reusable
    project tokens.
</p>

<ApiTable Rows="@MinMaxUtilities" />

<h3 class="@DocsStyles.H3">Available sizes</h3>
<ApiTable Rows="@SizeValues" />

<h3 class="@DocsStyles.H3">Arbitrary sizes with Length</h3>

<p class="@DocsStyles.P">
    A <code class="@DocsStyles.InlineCode">Length</code> works everywhere a
    <code class="@DocsStyles.InlineCode">Size</code> does, and covers units the named set does not
    include.
</p>

<CodeBlock Code="@LengthSizing" />

<Example Code="@LengthSizingExample">
    <div class="@(Css.MinH(HeroHeight).MaxW(ReadingWidth).P(6).RoundedLg().Background(Color.Emerald500).Color(Color.White))">
        min-height: 12rem, max-width: 65ch
    </div>
</Example>

<Example Code="@MaxWExample">
    <div class="@Css.MaxW(Size.Md).P(6).RoundedLg().Background(Color.Emerald500).Color(Color.White)">
        max-width: 48rem
    </div>
</Example>

@code {
    private static readonly (string Utility, string Css)[] SizeUtilities =
    [
        ("W(4)", "width: 1rem"),
        ("H(4)", "height: 1rem"),
        ("WFull()", "width: 100%"),
        ("WScreen()", "width: 100vw"),
        ("WAuto()", "width: auto"),
        ("HFull()", "height: 100%"),
        ("HScreen()", "height: 100vh"),
    ];

    private static readonly (string Utility, string Css)[] MinMaxUtilities =
    [
        ("MaxW(Size.Md)", "max-width: 48rem"),
        ("MinW(Size.Sm)", "min-width: 40rem"),
        ("MaxH(Size.Lg)", "max-height: 64rem"),
        ("MinH(Size.ScreenH)", "min-height: 100vh"),
        ("MaxW(Length.Px(720))", "max-width: 720px"),
        ("MinH(Length.Vh(100))", "min-height: 100vh"),
    ];

    private static readonly (string Utility, string Css)[] SizeValues =
    [
        ("Size.Sm", "40rem"),
        ("Size.Md", "48rem"),
        ("Size.Lg", "64rem"),
        ("Size.Xl", "80rem"),
        ("Size.Xxl", "96rem"),
        ("Size.Xxxl", "128rem"),
        ("Size.Full", "100%"),
        ("Size.ScreenW", "100vw"),
        ("Size.ScreenH", "100vh"),
        ("Size.Zero", "0px"),
        ("Size.Min", "min-content"),
        ("Size.Max", "max-content"),
        ("Size.Fit", "fit-content"),
    ];

    private const string SizeExample =
        """
        <div class="@Css.W(32).H(8)"></div>
        <div class="@Css.WFull().H(8)"></div>
        <div class="@Css.W(16).HFull()"></div>
        """;

    private const string MaxWExample =
        """
        <div class="@Css.MaxW(Size.Md).P(6)">
            max-width: 48rem
        </div>
        """;

    // Reusable Length tokens for the live example below.
    private static readonly Length HeroHeight = new("12rem", "hero");
    private static readonly Length ReadingWidth = new("65ch", "reading");

    private const string LengthSizing =
        """
        // Any Length works with MaxW / MinW / MaxH / MinH:
        Css.MaxW(Length.Px(720));                    // max-w-720px
        Css.MinW(Length.Percent(50));                // min-w-50%
        Css.MinH(Length.Vh(100));                    // min-h-100vh
        Css.MaxH(new Length("min-content", "min")); // max-h-min

        // Or a reusable token:
        public static readonly Length Reading = new("65ch", "reading");
        Css.MaxW(Reading);                           // max-w-reading
        """;

    private const string LengthSizingExample =
        """
        <div class="@(Css.MinH(HeroHeight).MaxW(ReadingWidth).P(6))">
            min-height: 12rem, max-width: 65ch
        </div>
        """;
}
