@page "/docs/typography"

<PageTitle>Typography - FluentCss</PageTitle>

<DocHeader Title="Typography"
           Description="Font size, weight, alignment, decoration, casing and line height, all controlled from the builder." />

<h2 class="@DocsStyles.H2">Font size</h2>

<ApiTable Rows="@FontSizes" />

<Example Code="@FontSizeExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 2)">
        <p class="@Css.TextXs()">text-xs (0.75rem)</p>
        <p class="@Css.TextSm()">text-sm (0.875rem)</p>
        <p class="@Css.TextBase()">text-base (1rem)</p>
        <p class="@Css.TextLg()">text-lg (1.125rem)</p>
        <p class="@Css.TextXl()">text-xl (1.25rem)</p>
        <p class="@Css.Text2Xl()">text-2xl (1.5rem)</p>
        <p class="@Css.Text3Xl()">text-3xl (1.875rem)</p>
    </div>
</Example>

<h3 class="@DocsStyles.H3">Custom font size with Length</h3>

<p class="@DocsStyles.P">
    <code class="@DocsStyles.InlineCode">Text</code> also accepts a <code class="@DocsStyles.InlineCode">Length</code>,
    so you can use any value or unit, including fluid <code class="@DocsStyles.InlineCode">clamp()</code> expressions.
</p>

<CodeBlock Code="@FontSizeLength" />

<Example Code="@FontSizeLengthExample">
    <p class="@Css.Text(Length.Rem(2.5))">text-2.5rem</p>
    <p class="@Css.Text(FluidText)">text-fluid</p>
</Example>

<h2 class="@DocsStyles.H2">Font weight and style</h2>

<ApiTable Rows="@FontStyles" />

<Example Code="@WeightExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 2)">
        <p class="@Css.FontThin()">Thin weight</p>
        <p class="@Css.FontNormal()">Normal weight</p>
        <p class="@Css.FontBold()">Bold weight</p>
        <p class="@Css.Italic()">Italic</p>
        <p class="@Css.NotItalic()">Not italic</p>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Font family</h2>

<p class="@DocsStyles.P">
    <code class="@DocsStyles.InlineCode">FontSans()</code>,
    <code class="@DocsStyles.InlineCode">FontSerif()</code> and
    <code class="@DocsStyles.InlineCode">FontMono()</code> apply the built-in stacks.
    <code class="@DocsStyles.InlineCode">Sans(...)</code>,
    <code class="@DocsStyles.InlineCode">Serif(...)</code> and
    <code class="@DocsStyles.InlineCode">Mono(...)</code> prepend one or more custom families
    to the matching default, and <code class="@DocsStyles.InlineCode">Font(FontFamily)</code>
    takes a fully custom stack.
</p>

<ApiTable Rows="@FontFamilies" />

<CodeBlock Code="@FontFamilyExample" />

<Example Code="@FontFamilyLiveExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 2)">
        <p class="@Css.Font(FontFamily.Sans)">font-sans &mdash; the default UI stack</p>
        <p class="@Css.Font(FontFamily.Serif)">font-serif &mdash; the default serif stack</p>
        <p class="@Css.Font(FontFamily.Mono)">font-mono &mdash; const answer = 42;</p>
        <p class="@Css.Font(BrandFont)">font-brand &mdash; a custom stack</p>
    </div>
</Example>

<Callout Kind="CalloutKind.Info" Title="Auto-derived class names">
    A font stack cannot become a class name: the HTML
    <code class="@DocsStyles.InlineCode">class</code> attribute is whitespace separated, so a stack
    like <code class="@DocsStyles.InlineCode">Inter, ui-sans-serif, system-ui</code> is not a valid
    token. When <code class="@DocsStyles.InlineCode">FontFamily.Name</code> is not set, a readable
    token is derived from the families and suffixed with a short hash, for example
    <code class="@DocsStyles.InlineCode">Sans("Inter")</code> &rarr;
    <code class="@DocsStyles.InlineCode">font-sans-inter-&lt;hash&gt;</code>. Pass an explicit name
    (<code class="@DocsStyles.InlineCode">new FontFamily(stack, "brand")</code>) when you want a
    clean, predictable class.
</Callout>

<h2 class="@DocsStyles.H2">Alignment and decoration</h2>

<ApiTable Rows="@TextUtilities" />

<Example Code="@AlignmentExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 2).WFull()">
        <p class="@Css.TextLeft()">Left aligned</p>
        <p class="@Css.TextCenter()">Center aligned</p>
        <p class="@Css.TextRight()">Right aligned</p>
        <p><span class="@Css.Underline()">Underlined</span> and <span class="@Css.NoUnderline()">not underlined</span></p>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Casing and whitespace</h2>

<ApiTable Rows="@TransformUtilities" />

<Example Code="@TransformExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 2)">
        <p class="@Css.Uppercase()">uppercase text</p>
        <p class="@Css.Lowercase()">LOWERCASE TEXT</p>
        <p class="@Css.Capitalize()">capitalize each word</p>
        <p class="@Css.WhitespaceNoWrap().OverflowHidden()">this line will not wrap no matter how long it becomes in the container</p>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Letter spacing</h2>

<ApiTable Rows="@TrackingUtilities" />

<h2 class="@DocsStyles.H2">Line height</h2>

<p class="@DocsStyles.P">
    <code class="@DocsStyles.InlineCode">Leading(n)</code> uses the spacing scale for
    <code class="@DocsStyles.InlineCode">line-height</code>: <code class="@DocsStyles.InlineCode">Leading(6)</code>
    is <code class="@DocsStyles.InlineCode">1.5rem</code>. The named helpers set the common unitless ratios.
</p>

<ApiTable Rows="@LeadingUtilities" />

<CodeBlock Code="@LeadingExample" />

<h2 class="@DocsStyles.H2">Text wrapping and overflow</h2>

<ApiTable Rows="@WrappingUtilities" />

<h2 class="@DocsStyles.H2">List styles</h2>

<ApiTable Rows="@ListUtilities" />

