@page "/not-found"
@layout MainLayout

<PageTitle>Not found - FluentCss</PageTitle>

<div class="@Css.TextCenter().Py(12)">
    <p class="@Css.Text3Xl().FontBold().Color(Color.Blue600) @Dark.Color(Color.Blue400)">404</p>
    <h1 class="@DocsStyles.H2 @Css.TextCenter()">Page not found</h1>
    <p class="@DocsStyles.P @Css.TextCenter()">
        The page you are looking for does not exist or has moved.
    </p>
    <div class="@Css.Flex(FlexDirection.Row, Justify.Center, gap: 4).Mt(4)">
        <a href="/" class="@DocsStyles.ButtonPrimary">Back to overview</a>
        <a href="/docs/utility-classes" class="@DocsStyles.ButtonSecondary">Browse utilities</a>
    </div>
</div>
