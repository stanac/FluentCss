@page "/docs/colors"

<PageTitle>Colors - FluentCss</PageTitle>

<DocHeader Title="Colors"
           Description="The full Tailwind color palette is available as strongly typed Color values: 22 families, 11 shades each, plus black and white." />

<h2 class="@DocsStyles.H2">Color utilities</h2>

<p class="@DocsStyles.P">
    Pass a <code class="@DocsStyles.InlineCode">Color</code> value to one of three methods. The color
    name becomes part of the generated class.
</p>

<ApiTable Rows="@ColorUtilities" />

<Example Code="@ColorExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 3)">
        <div class="@Css.P(4).RoundedMd().Background(Color.Red500).Color(Color.White).FontBold()">Red 500</div>
        <div class="@Css.P(4).RoundedMd().Background(Color.Emerald500).Color(Color.White).FontBold()">Emerald 500</div>
        <div class="@(Css.P(4).RoundedMd().Background(Color.White).Color(Color.Slate900).FontBold().Border().BorderColor(Color.Slate300))">White with border</div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Reading a color</h2>

<p class="@DocsStyles.P">
    Each <code class="@DocsStyles.InlineCode">Color</code> exposes the raw value as well, which is useful
    when you need the value in your own code.
</p>

<CodeBlock Code="@ReadColor" />

<h2 class="@DocsStyles.H2">Custom colors</h2>

<p class="@DocsStyles.P">
    The Tailwind palette is only a starting point. <code class="@DocsStyles.InlineCode">Color</code>
    has a public constructor, so you can create any color you need: the first argument is the
    <em>name</em> used to build the class, the second is any valid CSS color <em>value</em> (hex,
    <code class="@DocsStyles.InlineCode">rgb()</code>, <code class="@DocsStyles.InlineCode">oklch()</code>,
    even <code class="@DocsStyles.InlineCode">var(--brand)</code>).
</p>

<CodeBlock Code="@CustomColor" />

<Example Code="@CustomColorExample">
    <div class="@Css.Flex(FlexDirection.Row, gap: 3)">
        <div class="@Css.P(4).RoundedMd().Background(MyColors.Brand500).Color(Color.White).FontBold()">Brand 500</div>
        <div class="@Css.P(4).RoundedMd().Background(MyColors.Brand100).Color(MyColors.Brand900).FontBold()">Brand 100</div>
        <div class="@Css.P(4).RoundedMd().Border().BorderColor(MyColors.Brand500).Color(MyColors.Brand700).FontBold()">Outlined</div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Your own colors class</h2>

<p class="@DocsStyles.P">
    Group related colors in your own static class, exactly like
    <code class="@DocsStyles.InlineCode">FluentCss.Core.Color</code> does. The values are ordinary
    <code class="@DocsStyles.InlineCode">Color</code> instances, so they work everywhere a built-in
    color is accepted, including <code class="@DocsStyles.InlineCode">Hover</code>, responsive and
    theme variants.
</p>

<CodeBlock Code="@ColorsClass" />

<Callout Kind="CalloutKind.Warning" Title="The name is the identity">
    FluentCss deduplicates generated CSS by class name. A custom color's
    <code class="@DocsStyles.InlineCode">Name</code> becomes the class
    (<code class="@DocsStyles.InlineCode">bg-brand-500</code>), so it must be unique and stable. Two
    colors with the same name are treated as the same class, and the first value registered wins.
</Callout>

<h2 class="@DocsStyles.H2">The palette</h2>

<p class="@DocsStyles.P">
    Every family runs from shade 50 (lightest) to 950 (darkest). The swatches below are rendered with
    the builder itself.
</p>

@foreach (var family in Families)
{
    <div class="@DocsStyles.ColorFamilyRow">
        <p class="@DocsStyles.ColorFamilyName">
            @family.Family
        </p>
        <div class="@DocsStyles.ColorSwatchRow">
            @foreach (var shade in family.Shades)
            {
                <div class="@shade.Class" title="@shade.Name"></div>
            }
        </div>
    </div>
}

<h2 class="@DocsStyles.H2">Black and white</h2>

<div class="@Css.Flex(FlexDirection.Row, gap: 4).Mb(8)">
    <div class="@Css.P(6).RoundedLg().Background(Color.Black).Color(Color.White).FontBold()">Black</div>
    <div class="@(Css.P(6).RoundedLg().Background(Color.White).Color(Color.Black).FontBold().Border().BorderColor(Color.Slate300))">White</div>
</div>

@code {
    private static readonly (string Utility, string Css)[] ColorUtilities =
    [
        ("Background(Color.Red500)", "background-color: <value>  ->  bg-red-500"),
        ("Color(Color.Red500)", "color: <value>  ->  text-red-500"),
        ("BorderColor(Color.Red500)", "border-color: <value>  ->  border-red-500"),
    ];

    private static readonly (string Family, (string Name, string Class)[] Shades)[] Families = BuildFamilies();

    private static (string Family, (string Name, string Class)[] Shades)[] BuildFamilies()
    {
        return typeof(Color)
            .GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static)
            .Where(p => p.PropertyType == typeof(Color))
            .Select(p => (Color)p.GetValue(null)!)
            .Where(c => c.Name.Contains('-'))
            .GroupBy(c => c.Name.Split('-')[0])
            .OrderBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => (
                g.Key,
                g.OrderBy(c => int.Parse(c.Name.Split('-')[1]))
                    .Select(c => (c.Name, DocsStyles.ColorSwatch(c)))
                    .ToArray()))
            .ToArray();
    }

    private const string ColorExample =
        """
        <div class="@Css.P(4).RoundedMd()
                        .Background(Color.Red500)
                        .Color(Color.White).FontBold()">
            Red 500
        </div>
        """;

    private const string ReadColor =
        """
        Color emerald = Color.Emerald500;

        string name = emerald.Name;   // "emerald-500"
        string value = emerald.Value; // "oklch(0.696 0.17 162.48)"
        """;

    // The colors used by the live example below. In a real app this would live in
    // its own file (see ColorsClass for the shape).
    private static class MyColors
    {
        public static readonly Color Brand50 = new("brand-50", "#eef2ff");
        public static readonly Color Brand100 = new("brand-100", "#e0e7ff");
        public static readonly Color Brand300 = new("brand-300", "#a5b4fc");
        public static readonly Color Brand500 = new("brand-500", "#6366f1");
        public static readonly Color Brand700 = new("brand-700", "#4338ca");
        public static readonly Color Brand900 = new("brand-900", "#312e81");
    }

    private const string CustomColor =
        """
        // Color(name, value): the name becomes the class, the value is any CSS color.
        Color brand = new("brand-500", "#6366f1");

        Css.Background(brand);     // -> class: bg-brand-500
        Css.Color(brand);          // -> class: text-brand-500
        Css.BorderColor(brand);    // -> class: border-brand-500
        """;

    private const string CustomColorExample =
        """
        <div class="@Css.P(4).RoundedMd()
                        .Background(MyColors.Brand500)
                        .Color(Color.White).FontBold()">
            Brand 500
        </div>
        """;

    private const string ColorsClass =
        """
        public static class MyColors
        {
            public static readonly Color Brand50  = new("brand-50",  "#eef2ff");
            public static readonly Color Brand100 = new("brand-100", "#e0e7ff");
            public static readonly Color Brand300 = new("brand-300", "#a5b4fc");
            public static readonly Color Brand500 = new("brand-500", "#6366f1");
            public static readonly Color Brand700 = new("brand-700", "#4338ca");
            public static readonly Color Brand900 = new("brand-900", "#312e81");
        }

        // Then use them like any built-in color, including variants:
        Css.Background(MyColors.Brand500).Color(MyColors.Brand50);
        Css.Hover(h => h.Background(MyColors.Brand700));
        Dark.Color(MyColors.Brand100);
        """;
}
