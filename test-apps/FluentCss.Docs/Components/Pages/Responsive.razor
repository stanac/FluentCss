@page "/docs/responsive"

<PageTitle>Responsive design - FluentCss</PageTitle>

<DocHeader Title="Responsive design"
           Description="Wrap utilities in a media query builder. FluentCss prefixes the class names so the browser can apply them conditionally." />

<h2 class="@DocsStyles.H2">Min and max helpers</h2>

<p class="@DocsStyles.P">
    FluentCss ships with one default breakpoint, <code class="@DocsStyles.InlineCode">md</code>, at
    <code class="@DocsStyles.InlineCode">48rem</code>. Use <code class="@DocsStyles.InlineCode">MinMd</code>
    for screens at or above it and <code class="@DocsStyles.InlineCode">MaxMd</code> for screens below it.
</p>

<ApiTable Rows="@MediaHelpers" />

<Example Code="@ResponsiveExample">
    <div class="@Css.Grid().GridCols(1).Gap(4)
                    @Css.MinMd(md => md.GridCols(3))
                    @Css.Background(Color.Slate100) @Dark.Background(Color.Slate800)
                    @Css.P(4).RoundedLg()">
        <div class="@Css.Background(Color.Blue500).Color(Color.White).P(4).RoundedMd()">One</div>
        <div class="@Css.Background(Color.Indigo500).Color(Color.White).P(4).RoundedMd()">Two</div>
        <div class="@Css.Background(Color.Violet500).Color(Color.White).P(4).RoundedMd()">Three</div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Custom breakpoints</h2>

<p class="@DocsStyles.P">
    The <code class="@DocsStyles.InlineCode">Media</code> method accepts any media query and a short
    prefix used to build the class name. This is how you add the breakpoints your design needs.
</p>

<CodeBlock Code="@CustomBreakpoints" />

<Callout Kind="CalloutKind.Info" Title="Modern range syntax">
    The built-in helpers use the modern range syntax, for example
    <code class="@DocsStyles.InlineCode">@@media (width &gt; 48rem)</code>. Make sure your target
    browsers support it, which all current versions of Chrome, Edge, Firefox and Safari do.
</Callout>

<h2 class="@DocsStyles.H2">Combining with states</h2>

<p class="@DocsStyles.P">
    Responsive helpers take a full style builder, so states can be nested inside them. The class name
    lists media before pseudo.
</p>

<CodeBlock Code="@ResponsiveStates" />

@code {
    private static readonly (string Utility, string Css)[] MediaHelpers =
    [
        ("MinMd(md => ...)", "@media (width > 48rem), class prefix min-md:"),
        ("MaxMd(md => ...)", "@media (width < 48rem), class prefix max-md:"),
        ("Media(query, prefix, x => ...)", "any query, custom prefix"),
    ];

    private const string ResponsiveExample =
        """
        <div class="@Css.Grid().GridCols(1).Gap(4)
                        @Css.MinMd(md => md.GridCols(3))">
            ...
        </div>

        <!-- generated classes -->
        <!-- grid grid-cols-1 gap-4 min-md:grid-cols-3 -->
        """;

    private const string CustomBreakpoints =
        """
        FluentCssBuilder.Css
            .Grid()
            .GridCols(1)
            .Media("width > 40rem", "sm", x => x.GridCols(2))
            .Media("width > 64rem", "lg", x => x.GridCols(4));

        // classes: grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4
        """;

    private const string ResponsiveStates =
        """
        Css.Color(Color.Slate900)
           .MinMd(md => md.Color(Color.Blue700)
                          .Hover(h => h.Color(Color.Blue500)));

        // classes:
        // text-slate-900
        // min-md:text-blue-700
        // min-md:hover:text-blue-500
        """;
}
