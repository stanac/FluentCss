@page "/docs/flexbox-grid"

<PageTitle>Flexbox &amp; grid - FluentCss</PageTitle>

<DocHeader Title="Flexbox and grid"
           Description="Lay out with flexbox and CSS grid. A composite Flex helper covers the common container setup, while grid utilities handle the rest." />

<h2 class="@DocsStyles.H2">Flex containers</h2>

<p class="@DocsStyles.P">
    The composite <code class="@DocsStyles.InlineCode">Flex</code> method sets the display, direction and
    any of the optional justify, align, wrap and gap values in one call.
</p>

<CodeBlock Code="@FlexComposite" />

<Example Code="@FlexExample">
    <div class="@Css.Flex(FlexDirection.Row, Justify.Between, Align.Center, gap: 4)
                    @Css.P(4).RoundedLg().Background(Color.Slate100) @Dark.Background(Color.Slate800)">
        <div class="@Css.Px(4).Py(2).RoundedMd().Background(Color.Blue500).Color(Color.White)">Start</div>
        <div class="@Css.Px(4).Py(2).RoundedMd().Background(Color.Indigo500).Color(Color.White)">Middle</div>
        <div class="@Css.Px(4).Py(2).RoundedMd().Background(Color.Violet500).Color(Color.White)">End</div>
    </div>
</Example>

<h3 class="@DocsStyles.H3">Direction</h3>
<ApiTable Rows="@DirectionUtilities" />

<h3 class="@DocsStyles.H3">Justify content</h3>
<ApiTable Rows="@JustifyUtilities" />

<h3 class="@DocsStyles.H3">Align items</h3>
<ApiTable Rows="@AlignUtilities" />

<h3 class="@DocsStyles.H3">Wrap, grow and gap</h3>
<ApiTable Rows="@OtherFlexUtilities" />

<Example Code="@GrowExample">
    <div class="@Css.Flex(FlexDirection.Row, gap: 2)">
        <div class="@Css.P(3).RoundedMd().Background(Color.Emerald500).Color(Color.White)">Fixed</div>
        <div class="@Css.Grow().P(3).RoundedMd().Background(Color.Teal500).Color(Color.White)">Grow</div>
    </div>
</Example>

<h3 class="@DocsStyles.H3">Basis and order</h3>
<ApiTable Rows="@BasisOrderUtilities" />

<h3 class="@DocsStyles.H3">Justify and align self / content</h3>
<ApiTable Rows="@AlignmentUtilities" />

<h2 class="@DocsStyles.H2">Grid</h2>

<ApiTable Rows="@GridUtilities" />

<Example Code="@GridExample">
    <div class="@Css.Grid().GridCols(4).Gap(3)">
        <div class="@Css.ColSpan(2).P(3).RoundedMd().Background(Color.Blue500).Color(Color.White)">span 2</div>
        <div class="@Css.P(3).RoundedMd().Background(Color.Indigo500).Color(Color.White)">1</div>
        <div class="@Css.P(3).RoundedMd().Background(Color.Violet500).Color(Color.White)">1</div>
        <div class="@Css.P(3).RoundedMd().Background(Color.Purple500).Color(Color.White)">1</div>
        <div class="@Css.ColStart(3).P(3).RoundedMd().Background(Color.Fuchsia500).Color(Color.White)">start 3</div>
    </div>
</Example>

