@page "/docs/installation"

<PageTitle>Installation - FluentCss</PageTitle>

<DocHeader Title="Installation"
           Description="Pick the package for your hosting model, wire FluentCss up once and start composing styles." />

<h2 class="@DocsStyles.H2">Choose a package</h2>

<p class="@DocsStyles.P">
    Install the integration package that matches your app. ASP.NET Core MVC and Razor Pages apps also need the middleware package.
</p>

<table class="@DocsStyles.Table">
    <thead class="@DocsStyles.Thead">
        <tr>
            <th class="@DocsStyles.Th">Package</th>
            <th class="@DocsStyles.Th">Hosting model</th>
            <th class="@DocsStyles.Th">What it gives you</th>
        </tr>
    </thead>
    <tbody>
        <tr class="@DocsStyles.Tr">
            <td class="@DocsStyles.Td"><code class="@DocsStyles.InlineCode">FluentCss</code></td>
            <td class="@DocsStyles.Td">Blazor, and MVC / Razor Pages</td>
            <td class="@DocsStyles.Td">
                The <code class="@DocsStyles.InlineCode">CssStyles</code> component, the
                <code class="@DocsStyles.InlineCode">&lt;fluent-css /&gt;</code> and theme tag helpers and the
                preflight stylesheet. Use it for Blazor static SSR, Blazor Server, Blazor WebAssembly
                (standalone) and Blazor Web Apps using the Interactive Server, Interactive WebAssembly or Auto
                render mode, as well as for the server-rendered markup of MVC and Razor Pages.
            </td>
        </tr>
        <tr class="@DocsStyles.Tr">
            <td class="@DocsStyles.Td"><code class="@DocsStyles.InlineCode">FluentCss.Middleware</code></td>
            <td class="@DocsStyles.Td">ASP.NET Core MVC and Razor Pages</td>
            <td class="@DocsStyles.Td">
                The stylesheet middleware and the <code class="@DocsStyles.InlineCode">AddFluentCss()</code> /
                <code class="@DocsStyles.InlineCode">UseFluentCss()</code> extensions.
            </td>
        </tr>
    </tbody>
</table>

<Callout Kind="CalloutKind.Tip" Title="FluentCss.Core is transitive dependency">
    Both integration packages depend on <code class="@DocsStyles.InlineCode">FluentCss.Core</code> and bring it in
    automatically.
</Callout>

<h2 class="@DocsStyles.H2">Blazor</h2>

<p class="@DocsStyles.P">Add the Blazor package:</p>

<CodeBlock Code="@InstallBlazor" Language="bash" />

<p class="@DocsStyles.P">
    For the shortest syntax add the following to your <code class="@DocsStyles.InlineCode">_Imports.razor</code>.
    Importing the static builder means you can start a chain with <code class="@DocsStyles.InlineCode">Css</code> or
    <code class="@DocsStyles.InlineCode">Dark</code> directly.
</p>

<CodeBlock Code="@ImportsBlazor" Language="cshtml" />

<p class="@DocsStyles.P">
    Drop the <code class="@DocsStyles.InlineCode">CssStyles</code> component into your layout. It renders a
    <code class="@DocsStyles.InlineCode">&lt;style&gt;</code> block with every class registered while the page is
    built.
</p>

<CodeBlock Code="@LayoutBlazor" Language="cshtml" />

<Callout Kind="CalloutKind.Tip" Title="Keep the loading and error styles as plain CSS">
    The Blazor template's loading indicator and error UI are present in the HTML before the interactive
    component tree renders, so in a standalone WebAssembly app they can be visible before
    <code class="@DocsStyles.InlineCode">CssStyles</code> has emitted its stylesheet. Put those few rules
    in a separate plain CSS file (for example
    <code class="@DocsStyles.InlineCode">wwwroot/app.css</code>) and link it from
    <code class="@DocsStyles.InlineCode">index.html</code> or
    <code class="@DocsStyles.InlineCode">App.razor</code>. This documentation site does exactly that:
    the loading and error rules live in
    <code class="@DocsStyles.InlineCode">wwwroot/css/site.css</code>. You do not need the form
    validation or <code class="@DocsStyles.InlineCode">form-floating</code> rules unless you use
    <code class="@DocsStyles.InlineCode">EditForm</code> validation.
</Callout>

<h3 class="@DocsStyles.H3">Interactive rendering</h3>

<p class="@DocsStyles.P">
    <code class="@DocsStyles.InlineCode">CssStyles</code> is more than a snapshot of the classes seen so far: it
    subscribes to the class registry and re-renders its <code class="@DocsStyles.InlineCode">&lt;style&gt;</code>
    block whenever a new class is registered. A component that renders later on the client - a dialog, a tab or
    anything that only appears after a click - is therefore styled as soon as it renders, with no page reload.
</p>

<p class="@DocsStyles.P">
    For that to work <code class="@DocsStyles.InlineCode">CssStyles</code> has to live <em>inside</em> the
    interactive render boundary. In a Blazor Web App that means the layout, or anything else under
    <code class="@DocsStyles.InlineCode">&lt;Routes&gt;</code>, rather than the statically rendered
    <code class="@DocsStyles.InlineCode">App.razor</code> head:
</p>

<CodeBlock Code="@InteractiveBlazor" Language="cshtml" />

<Callout Kind="CalloutKind.Info" Title="Registration follows the process">
    Classes are registered in the process that renders the component. A prerender fills the server registry;
    interactive WebAssembly fills one inside the browser; an interactive server circuit runs in the server process
    and shares its registry with the prerender. Whichever runtime is active owns a
    <code class="@DocsStyles.InlineCode">CssStyles</code> instance and re-emits the stylesheet when that runtime
    registers new classes. The Interactive Server, Interactive WebAssembly and Auto render modes are all
    supported.
</Callout>

<Callout Kind="CalloutKind.Info" Title="Prefer the script-link path?">
    <code class="@DocsStyles.InlineCode">CssStyles</code> is the Blazor-native way to emit the stylesheet, but a
    server-hosted Blazor app (Blazor Server or a Blazor Web App) can use the same middleware and script-link
    setup as MVC and Razor Pages instead. The tag helpers ship in the
    <code class="@DocsStyles.InlineCode">FluentCss</code> package next to
    <code class="@DocsStyles.InlineCode">CssStyles</code>; the middleware itself is in
    <code class="@DocsStyles.InlineCode">FluentCss.Middleware</code>. See the next section for the setup.
</Callout>

<h2 class="@DocsStyles.H2">MVC and Razor Pages</h2>

<p class="@DocsStyles.P">
    Add the <code class="@DocsStyles.InlineCode">FluentCss</code> package for the tag helpers and the
    <code class="@DocsStyles.InlineCode">FluentCss.Middleware</code> package for the middleware:
</p>

<CodeBlock Code="@InstallMvcRazor" Language="bash" />

<p class="@DocsStyles.P">
    Register the middleware in <code class="@DocsStyles.InlineCode">Program.cs</code>. It serves the current hash at
    <code class="@DocsStyles.InlineCode">/fluentcss/hash</code> and the stylesheet at
    <code class="@DocsStyles.InlineCode">/fluentcss/{hash}.css</code>, with gzip and an ETag.
</p>

<CodeBlock Code="@ProgramMvcRazor" Language="csharp" />

<p class="@DocsStyles.P">
    Razor Pages apps map their pages instead with <code class="@DocsStyles.InlineCode">app.MapRazorPages()</code>;
    the middleware and the tag helper are identical for both models.
</p>

<p class="@DocsStyles.P">
    Register the tag helper and the namespaces in <code class="@DocsStyles.InlineCode">_ViewImports.cshtml</code>
    (or <code class="@DocsStyles.InlineCode">Pages/_ViewImports.cshtml</code>):
</p>

<CodeBlock Code="@ImportsMvcRazor" Language="cshtml" />

<p class="@DocsStyles.P">
    Finally add the tag helper and the preflight stylesheet to your layout. The tag helper renders the
    stylesheet <code class="@DocsStyles.InlineCode">&lt;link&gt;</code> and a small script that keeps it in sync
    after client-side DOM changes, such as a partial view loaded over AJAX.
</p>

<CodeBlock Code="@LayoutMvcRazor" Language="cshtml" />

<Callout Kind="CalloutKind.Info" Title="No need to add hash or timestamp">
    The tag helper resolves the current hash when the layout renders, but classes can still be registered after
    that point. The injected script re-reads <code class="@DocsStyles.InlineCode">/fluentcss/hash</code> on load and
    watches the document for later changes, swapping the stylesheet when it changes.
</Callout>

<h2 class="@DocsStyles.H2">Any other .NET project</h2>

<p class="@DocsStyles.P">
    Outside of Blazor and MVC/Razor Pages there is no integration package, so add the core library directly:
</p>

<CodeBlock Code="@InstallCore" Language="bash" />

<p class="@DocsStyles.P">
    You can then build classes and read the generated CSS from any .NET application.
    <code class="@DocsStyles.InlineCode">ToString()</code> returns the space separated class names for your
    <code class="@DocsStyles.InlineCode">class</code> attribute, while
    <code class="@DocsStyles.InlineCode">ClassRegistry.DefaultRegistry.Css</code> gives you the stylesheet.
</p>

<CodeBlock Code="@NonBlazor" />

@code {
    private const string InstallBlazor =
        """
        dotnet add package FluentCss
        """;

    private const string ImportsBlazor =
        """
        @using static FluentCss.Core.FluentCssBuilder
        @using FluentCss.Core
        """;

    private const string LayoutBlazor =
        """
        <!-- MainLayout.razor or App.razor -->
        ...
        <head>
        ...
        
        <!-- Add Tailwind CSS preflight, optional but strongly recommended -->
        <link rel="stylesheet" href="_content/FluentCss/preflight.css" />
        <FluentCss.CssStyles />
        
        ...
        </head>
        
        <body>...</body>
        
        """;

    private const string InteractiveBlazor =
        """
        <!-- App.razor: the render mode decides where interactivity runs -->
        <Routes @rendermode="InteractiveWebAssembly" />

        <!-- MainLayout.razor: CssStyles is part of the interactive tree -->
        @inherits LayoutComponentBase
        
        <FluentCss.CssStyles />
        
        <main>@Body</main>
        """;

    private const string InstallMvcRazor =
        """
        dotnet add package FluentCss
        dotnet add package FluentCss.Middleware
        """;

    private const string ProgramMvcRazor =
        """
        builder.Services.AddFluentCss();

        var app = builder.Build();

        app.UseRouting();
        app.UseFluentCss();   // serve /fluentcss/hash and /fluentcss/{hash}.css
        app.UseAuthorization();

        app.MapStaticAssets();
        app.MapControllerRoute("default", "{controller=Home}/{action=Index}/{id?}");
        """;

    private const string ImportsMvcRazor =
        """
        @using static FluentCss.Core.FluentCssBuilder
        @using FluentCss.Core
        @addTagHelper *, FluentCss
        """;

    private const string LayoutMvcRazor =
        """
        <head>
            ...
            <link rel="stylesheet" href="/_content/FluentCss/preflight.css" />
            <fluent-css />
        </head>
        """;

    private const string InstallCore =
        """
        dotnet add package FluentCss.Core
        """;

    private const string NonBlazor =
        """
        using FluentCss.Core;

        var classes = FluentCssBuilder.Css
            .Background(Color.Emerald500)
            .Color(Color.White)
            .Px(6)
            .Py(3)
            .RoundedMd();

        // "bg-emerald-500 text-white px-6 py-3 rounded-md"
        string classAttr = classes.ToString();

        // The complete, deduplicated stylesheet
        string css = ClassRegistry.DefaultRegistry.Css;
        """;
}
