@page "/docs/states"

<PageTitle>Hover &amp; focus - FluentCss</PageTitle>

<DocHeader Title="Hover, focus and other states"
           Description="Pseudo-classes are just another fluent call. Wrap the styles you want and FluentCss prefixes the class names." />

<h2 class="@DocsStyles.H2">Built-in states</h2>

<p class="@DocsStyles.P">
    Three helpers cover the common interactions. Pass an action that receives a
    <code class="@DocsStyles.InlineCode">IOnlyStyleBuilder</code> and style the element as usual.
</p>

<ApiTable Rows="@StateHelpers" />

<Example Code="@ButtonExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 4) @Css.MinMd(md => md.Flex(FlexDirection.Row))">
        <button class="@Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
                        @Css.Background(Color.Blue500).Color(Color.White)
                        @Css.Hover(h => h.Background(Color.Blue600))
                        @Css.Active(a => a.Background(Color.Blue700))
                        @Css.Focus(f => f.Ring(3, Color.Blue300).OutlineHidden())">
            Blue button
        </button>
        <button class="@Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
                        @Css.Background(Color.Emerald500).Color(Color.White)
                        @Css.Hover(h => h.Background(Color.Emerald600))
                        @Css.Active(a => a.Background(Color.Emerald700))
                        @Css.Focus(f => f.Ring(3, Color.Emerald300).OutlineHidden())">
            Green button
        </button>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Custom pseudo-classes</h2>

<p class="@DocsStyles.P">
    <code class="@DocsStyles.InlineCode">Pseudo</code> accepts any selector text. The value is trimmed of
    surrounding colons and then used both in the class name and in the generated selector.
</p>

<CodeBlock Code="@CustomPseudo" />

<h2 class="@DocsStyles.H2">Combining with a theme</h2>

<p class="@DocsStyles.P">
    Because the theme is carried by the root builder, the same pseudo action can be used inside
    <code class="@DocsStyles.InlineCode">Dark</code>. The resulting class name reads from left to right:
    theme first, then the pseudo.
</p>

<CodeBlock Code="@DarkState" />

<Example Code="@DarkExample">
    <button class="@Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
                    @Css.Background(Color.Slate200).Color(Color.Slate800)
                    @Css.Hover(h => h.Background(Color.Slate300))
                    @Dark.Background(Color.Slate800).Color(Color.Slate100)
                    @Dark.Hover(h => h.Background(Color.Slate700))">
        Theme aware button
    </button>
</Example>

<Callout Kind="CalloutKind.Info" Title="Styles only inside a state">
    The builder passed to <code class="@DocsStyles.InlineCode">Hover</code>, <code class="@DocsStyles.InlineCode">Focus</code>
    and <code class="@DocsStyles.InlineCode">Active</code> intentionally exposes utilities but no nested
    states. Combine a pseudo with a responsive or theme variant from the outside instead.
</Callout>

@code {
    private static readonly (string Utility, string Css)[] StateHelpers =
    [
        ("Hover(h => ...)", "hover: prefix, :hover selector"),
        ("Focus(f => ...)", "focus: prefix, :focus selector"),
        ("Active(a => ...)", "active: prefix, :active selector"),
        ("Pseudo(\"first-child\", x => ...)", "first-child: prefix with a matching selector"),
    ];

    private const string ButtonExample =
        """
        <button class="@Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
                        @Css.Background(Color.Blue500).Color(Color.White)
                        @Css.Hover(h => h.Background(Color.Blue600))
                        @Css.Active(a => a.Background(Color.Blue700))
                        @Css.Focus(f => f.Ring(3, Color.Blue300).OutlineHidden())">
            Blue button
        </button>
        """;

    private const string CustomPseudo =
        """
        Css.Pseudo("first-child", x => x.Background(Color.Slate100));

        // class name: first-child:bg-slate-100
        // selector:  .first-child\:bg-slate-100:first-child
        """;

    private const string DarkState =
        """
        Dark
            .Background(Color.Slate800)
            .Hover(h => h.Background(Color.Slate700));

        // class names:
        // theme-dark:bg-slate-800
        // theme-dark:hover:bg-slate-700
        """;

    private const string DarkExample =
        """
        <button class="@Css.Px(6).Py(3).RoundedMd().FontBold().CursorPointer()
                        @Css.Background(Color.Slate200).Color(Color.Slate800)
                        @Css.Hover(h => h.Background(Color.Slate300))
                        @Dark.Background(Color.Slate800).Color(Color.Slate100)
                        @Dark.Hover(h => h.Background(Color.Slate700))">
            Theme aware button
        </button>
        """;
}
