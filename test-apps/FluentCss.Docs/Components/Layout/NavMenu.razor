@inject NavigationManager Navigation
@implements IDisposable

<nav>
    <a href="/" class="@DocsStyles.Brand">
        <img src="_content/FluentCss.Docs/logo.svg" alt="" class="@DocsStyles.BrandMark" />
        <span>FluentCss</span>
    </a>

    @foreach (var group in DocsNavigation.Sections)
    {
        <p class="@DocsStyles.SectionTitle">@group.Title</p>
        <ul>
            @foreach (var item in group.Items)
            {
                <li>
                    <a href="@item.Href" class="@GetLinkClass(item.Href)">@item.Title</a>
                </li>
            }
        </ul>
    }
</nav>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetLinkClass(string href) =>
        IsActive(href) ? DocsStyles.NavActive : DocsStyles.NavLink;

    private bool IsActive(string href)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        if (path.Length > 1 && path.EndsWith('/'))
        {
            path = path.TrimEnd('/');
        }

        if (href == "/")
        {
            return path == "/";
        }

        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
