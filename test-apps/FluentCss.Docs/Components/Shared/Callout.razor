<div class="@WrapClass">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <p class="@DocsStyles.CalloutTitle">@Title</p>
    }
    <div class="@DocsStyles.CalloutBody">@ChildContent</div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public CalloutKind Kind { get; set; } = CalloutKind.Info;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string WrapClass => Kind switch
    {
        CalloutKind.Tip => DocsStyles.CalloutTip,
        CalloutKind.Warning => DocsStyles.CalloutWarning,
        _ => DocsStyles.CalloutInfo,
    };
}
