@page "/about"

<PageTitle>About - FluentCss Interactive Server</PageTitle>

<h1 class="@Styles.PageTitle">About</h1>
<p class="@Styles.Lead">
    This project is a minimal interactive-server-rendered Blazor site. Every element is styled with the
    fluent builder, so navigating between pages registers new utility classes in the process-wide registry
    and the live circuit re-renders the emitted stylesheet.
</p>

<div class="@Styles.FactGrid">
    @foreach (var fact in Facts)
    {
        <div class="@Styles.FactCard">
            <p class="@Styles.FactTitle">@fact.Title</p>
            <p class="@Styles.FactBody">@fact.Body</p>
        </div>
    }
</div>

@code {
    private static readonly (string Title, string Body)[] Facts =
    [
        ("Interactive circuit", "Pages run on a live SignalR circuit over the server."),
        ("Stateful pages", "Components keep their state between renders and interactions."),
        ("Shared registry", "Classes are collected and deduplicated across circuits and requests."),
    ];
}
