<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FluentCssBlazorInteractiveServer.styles.css"]" />
    <link rel="stylesheet" href="_content/FluentCss.Blazor/preflight.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <script>
        function fcApplyTheme() {
            try {
                var saved = localStorage.getItem('fluentcss-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var dark = saved === 'dark' || (!saved && prefersDark);
                document.documentElement.classList.toggle('theme-dark', dark);
            } catch (e) { }
        }

        fcApplyTheme();

        function fcToggleTheme() {
            var root = document.documentElement;
            var dark = root.classList.toggle('theme-dark');
            try {
                localStorage.setItem('fluentcss-theme', dark ? 'dark' : 'light');
            } catch (e) { }
        }
    </script>
</head>

<body class="@BodyClass">
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly string BodyClass =
        $"{Css.Background(Color.White).Color(Color.Slate900)} " +
        $"{Dark.Background(Color.Slate950).Color(Color.Slate100)}";
}
