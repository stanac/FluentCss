@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="@Styles.Shell">
    <header class="@Styles.Header">
        <nav class="@Styles.Nav">
            <a href="/" class="@Styles.Brand">
                FluentCss Interactive Server
            </a>
            <div class="@Styles.NavLinks">
                <a href="/" class="@GetLinkClass("/")">Home</a>
                <a href="/about" class="@GetLinkClass("/about")">About</a>
                <a href="/contact" class="@GetLinkClass("/contact")">Contact</a>
                <ThemeToggle />
            </div>
        </nav>
    </header>

    <main class="@Styles.Main">
        @Body
    </main>

    <footer class="@Styles.Footer">
        &copy; @DateTime.Now.Year FluentCss Interactive Server test site
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@* <CssStyles /> lives inside the interactive server render boundary (Routes), so
   it re-renders on the circuit whenever a page registers new utility classes. *@
<FluentCss.CssStyles />

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetLinkClass(string href) =>
        IsActive(href) ? Styles.NavLinkActive : Styles.NavLink;

    private bool IsActive(string href)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        if (path.Length > 1 && path.EndsWith('/'))
        {
            path = path.TrimEnd('/');
        }

        return href == "/"
            ? path == "/"
            : path.Equals(href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
