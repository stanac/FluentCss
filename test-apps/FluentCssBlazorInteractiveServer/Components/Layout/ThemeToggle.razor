<button type="button"
        class="@Css.Px(3).Py(2).RoundedMd().CursorPointer().TextSm().FontBold().Color(Color.Slate600).Background(Color.Slate100).Hover(h => h.Background(Color.Slate200)) @Dark.Background(Color.Slate800).Color(Color.Slate200) @Dark.Hover(h => h.Background(Color.Slate700))"
        aria-label="Toggle color theme" title="Toggle color theme"
        onclick="fcToggleTheme()">
    @* Moon: shown in light mode, switches to dark *@
    <svg class="@Css.W(5).H(5).Block() @Dark.Hidden()" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
    @* Sun: shown in dark mode, switches to light *@
    <svg class="@Css.W(5).H(5).Hidden() @Dark.Block()" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
</button>
