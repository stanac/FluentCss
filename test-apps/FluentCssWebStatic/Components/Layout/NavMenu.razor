@inject NavigationManager Navigation

<nav>
    <a href="/" data-enhance-nav="false" class="@DocsStyles.Brand">
        <span class="@DocsStyles.BrandMark">F</span>
        <span>FluentCss</span>
    </a>

    @foreach (var group in DocsNavigation.Sections)
    {
        <p class="@DocsStyles.SectionTitle">@group.Title</p>
        <ul>
            @foreach (var item in group.Items)
            {
                <li>
                    <a href="@item.Href" data-enhance-nav="false" class="@GetLinkClass(item.Href)">@item.Title</a>
                </li>
            }
        </ul>
    }
</nav>

@code {
    private string GetLinkClass(string href) =>
        IsActive(href) ? DocsStyles.NavActive : DocsStyles.NavLink;

    private bool IsActive(string href)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        if (path.Length > 1 && path.EndsWith('/'))
        {
            path = path.TrimEnd('/');
        }

        if (href == "/")
        {
            return path == "/";
        }

        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }
}
