@page "/borders-effects"

<PageTitle>Borders &amp; effects - FluentCss</PageTitle>

<DocHeader Title="Borders and effects"
           Description="Outline your surfaces with borders and radius, then add rings, shadows and opacity." />

<h2 class="@DocsStyles.H2">Border width</h2>

<ApiTable Rows="@BorderWidths" />

<Example Code="@BorderExample">
    <div class="@Css.Flex(FlexDirection.Col, gap: 3)">
        <div class="@Css.Border().BorderColor(Color.Slate300).P(4).RoundedMd()">1px border</div>
        <div class="@Css.Border(2).BorderColor(Color.Slate300).P(4).RoundedMd()">2px border</div>
        <div class="@Css.Border(2, Color.Blue400, BorderStyle.Dashed).P(4).RoundedMd()">Dashed blue border</div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Border style and color</h2>

<ApiTable Rows="@BorderStyles" />

<p class="@DocsStyles.P">
    The composite overload combines the three border pieces in a single call:
</p>

<CodeBlock Code="@BorderComposite" />

<h2 class="@DocsStyles.H2">Border radius</h2>

<ApiTable Rows="@RadiusUtilities" />

<Example Code="@RadiusExample">
    <div class="@Css.Flex(FlexDirection.Row, gap: 3)">
        <div class="@Css.RoundedSm().W(16).H(16).Background(Color.Blue500)"></div>
        <div class="@Css.RoundedMd().W(16).H(16).Background(Color.Indigo500)"></div>
        <div class="@Css.RoundedLg().W(16).H(16).Background(Color.Violet500)"></div>
        <div class="@Css.RoundedFull().W(16).H(16).Background(Color.Purple500)"></div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Rings and outlines</h2>

<p class="@DocsStyles.P">
    A ring is a <code class="@DocsStyles.InlineCode">box-shadow</code> based outline that follows the
    border radius, which makes it ideal for focus states. The outline helpers map to the native
    <code class="@DocsStyles.InlineCode">outline</code> property.
</p>

<ApiTable Rows="@RingOutlineUtilities" />

<Example Code="@RingExample">
    <div class="@Css.Flex(FlexDirection.Row, gap: 4)">
        <button class="@Css.Px(5).Py(2).RoundedMd().Background(Color.White).Color(Color.Slate800)
                        .Border().BorderColor(Color.Slate300).FontBold().CursorPointer()
                        @Css.Focus(f => f.Ring(3, Color.Blue300).OutlineHidden())">
            Focus me
        </button>
        <div class="@Css.Ring(4, Color.Red400).P(3).RoundedFull().Background(Color.White).Color(Color.Slate800)">
            Ring
        </div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Shadows</h2>

<ApiTable Rows="@ShadowUtilities" />

<Example Code="@ShadowExample">
    <div class="@Css.Flex(FlexDirection.Row, gap: 4).ItemsCenter()">
        <div class="@Css.ShadowSm().P(4).RoundedMd().Background(Color.White) @Dark.Background(Color.Slate800)">sm</div>
        <div class="@Css.ShadowMd().P(4).RoundedMd().Background(Color.White) @Dark.Background(Color.Slate800)">md</div>
        <div class="@Css.ShadowLg().P(4).RoundedMd().Background(Color.White) @Dark.Background(Color.Slate800)">lg</div>
    </div>
</Example>

<h2 class="@DocsStyles.H2">Opacity and cursor</h2>

<ApiTable Rows="@MiscUtilities" />

<Example Code="@OpacityExample">
    <div class="@Css.Flex(FlexDirection.Row, gap: 3)">
        <div class="@Css.Opacity(100).P(4).RoundedMd().Background(Color.Blue500)"></div>
        <div class="@Css.Opacity(75).P(4).RoundedMd().Background(Color.Blue500)"></div>
        <div class="@Css.Opacity(50).P(4).RoundedMd().Background(Color.Blue500)"></div>
        <div class="@Css.Opacity(25).P(4).RoundedMd().Background(Color.Blue500)"></div>
    </div>
</Example>

@code {
    private static readonly (string Utility, string Css)[] BorderWidths =
    [
        ("Border()", "border-width: 1px"),
        ("Border(2)", "border-width: 2px"),
        ("Border(4)", "border-width: 4px"),
    ];

    private static readonly (string Utility, string Css)[] BorderStyles =
    [
        ("BorderColor(Color.Slate300)", "border-color: <value>"),
        ("BorderSolid()", "border-style: solid"),
        ("BorderDashed()", "border-style: dashed"),
        ("BorderDotted()", "border-style: dotted"),
    ];

    private static readonly (string Utility, string Css)[] RadiusUtilities =
    [
        ("RoundedSm()", "border-radius: 0.125rem"),
        ("Rounded()", "border-radius: 0.25rem"),
        ("RoundedMd()", "border-radius: 0.375rem"),
        ("RoundedLg()", "border-radius: 0.5rem"),
        ("RoundedFull()", "border-radius: 9999px"),
    ];

    private static readonly (string Utility, string Css)[] RingOutlineUtilities =
    [
        ("Ring(3, Color.Blue300)", "box-shadow: 0 0 0 3px <value>"),
        ("Outline(2)", "outline-width: 2px"),
        ("OutlineHidden()", "outline: 2px solid transparent"),
    ];

    private static readonly (string Utility, string Css)[] ShadowUtilities =
    [
        ("ShadowSm()", "box-shadow: small"),
        ("Shadow()", "box-shadow: default"),
        ("ShadowMd()", "box-shadow: medium"),
        ("ShadowLg()", "box-shadow: large"),
    ];

    private static readonly (string Utility, string Css)[] MiscUtilities =
    [
        ("Opacity(50)", "opacity: 0.5"),
        ("Opacity(0)", "opacity: 0"),
        ("Opacity(100)", "opacity: 1"),
        ("CursorPointer()", "cursor: pointer"),
    ];

    private const string BorderExample =
        """
        <div class="@Css.Border().BorderColor(Color.Slate300).P(4)">1px border</div>
        <div class="@Css.Border(2).BorderColor(Color.Slate300).P(4)">2px border</div>
        <div class="@Css.Border(2, Color.Blue400, BorderStyle.Dashed).P(4)">Dashed blue border</div>
        """;

    private const string BorderComposite =
        """
        Css.Border(2, Color.Slate300, BorderStyle.Dashed);

        // expands to three utilities:
        // border-2        border-width: 2px
        // border-slate-300 border-color: ...
        // border-dashed   border-style: dashed
        """;

    private const string RadiusExample =
        """
        <div class="@Css.RoundedSm().W(16).H(16).Background(Color.Blue500)"></div>
        <div class="@Css.RoundedFull().W(16).H(16).Background(Color.Purple500)"></div>
        """;

    private const string RingExample =
        """
        <button class="@Css.Px(5).Py(2).RoundedMd().FontBold()
                        @Css.Focus(f => f.Ring(3, Color.Blue300).OutlineHidden())">
            Focus me
        </button>
        """;

    private const string ShadowExample =
        """
        <div class="@Css.ShadowSm().P(4).RoundedMd().Background(Color.White)">sm</div>
        <div class="@Css.ShadowMd().P(4).RoundedMd().Background(Color.White)">md</div>
        <div class="@Css.ShadowLg().P(4).RoundedMd().Background(Color.White)">lg</div>
        """;

    private const string OpacityExample =
        """
        <div class="@Css.Opacity(100).P(4).Background(Color.Blue500)"></div>
        <div class="@Css.Opacity(50).P(4).Background(Color.Blue500)"></div>
        <div class="@Css.Opacity(25).P(4).Background(Color.Blue500)"></div>
        """;
}
